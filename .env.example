# Обязательно для реального Telegram-бота
BOT_TOKEN=
OWNER_TELEGRAM_ID=0

# Обязательно для анализа фотографий и AI-меню
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Публичный HTTPS-адрес после размещения на сервере
WEBAPP_URL=http://localhost:8000

# Локальные настройки
DATABASE_PATH=data/nutrition.db
HOST=0.0.0.0
PORT=8000
RUN_BOT=true
DEV_MODE=true

